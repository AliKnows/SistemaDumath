---
import Layout from '../layouts/Layout.astro';
---

<Layout title="DUMATH | Registro">
	<main class="auth-screen">
		<section class="auth-card retro-card">
			<p class="eyebrow">DUMATH</p>
			<h1>CREAR CUENTA</h1>
			<form id="register-form" class="auth-form">
				<label for="name">NOMBRE</label>
				<input class="retro-input" id="name" name="name" required maxlength="255" />
				<label for="email">CORREO</label>
				<input class="retro-input" id="email" name="email" type="email" required />
				<label for="password">CONTRASEÑA</label>
				<input class="retro-input" id="password" name="password" type="password" minlength="8" required />
				<label for="password_confirmation">CONFIRMAR CONTRASEÑA</label>
				<input class="retro-input" id="password_confirmation" name="password_confirmation" type="password" minlength="8" required />
				<button class="retro-btn-yellow" type="submit">REGISTRAR</button>
				<p id="form-message" class="form-message" role="alert"></p>
			</form>
			<a class="secondary-link" href="/login">VOLVER AL ACCESO</a>
		</section>
	</main>
</Layout>

<script>
	const form = document.querySelector<HTMLFormElement>('#register-form');
	const message = document.querySelector<HTMLParagraphElement>('#form-message');
	const button = form?.querySelector<HTMLButtonElement>('button');
	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!form || !button || !message) return;
		button.disabled = true;
		button.textContent = 'GUARDANDO';
		try {
			const response = await fetch('/api/register', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(form))) });
			const data = await response.json();
			if (!response.ok) throw new Error(data.message || 'No se pudo crear la cuenta.');
			localStorage.setItem('dumath_token', data.access_token);
			localStorage.setItem('dumath_user', JSON.stringify(data.user));
			window.location.assign('/panel');
		} catch (error) {
			message.textContent = error instanceof Error ? error.message : 'Error de conexión.';
			button.disabled = false;
			button.textContent = 'REGISTRAR';
		}
	});
</script>

<style>
	.auth-screen { min-height: 100vh; display: grid; place-items: center; padding: 24px; }
	.auth-card { width: min(100%, 420px); padding: 32px; text-align: center; }
	.eyebrow { color: var(--color-yellow-primary); font-family: var(--font-retro); font-size: .75rem; letter-spacing: 2px; }
	h1 { margin: 20px 0 24px; font-family: var(--font-retro); font-size: 1.15rem; }
	.auth-form { display: grid; gap: 10px; text-align: left; }
	.auth-form label { color: var(--color-yellow-primary); font-family: var(--font-retro); font-size: .62rem; margin-top: 8px; }
	.auth-form button { margin-top: 16px; }
	.form-message { min-height: 20px; color: #fca5a5; text-align: center; font-size: .9rem; }
	.secondary-link { display: inline-block; margin-top: 20px; color: var(--color-yellow-primary); font-family: var(--font-retro); font-size: .6rem; }
	button:disabled { cursor: wait; opacity: .65; }
</style>
