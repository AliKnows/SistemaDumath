---
import Layout from '../layouts/Layout.astro';
import background3 from '../assets/images/3BackgroundDUMATH.jpg';
---

<Layout title="DUMATH - Juego">
	<div class="game-view-wrapper" style={`--game-background: url(${background3.src})`}>
		<!-- Topbar Arcade Retro -->
		<header class="game-topbar">
			<div class="topbar-left">
				<a href="/demo" class="game-logo">
					<span class="logo-main">DUMATH</span>
				</a>
			</div>

			<div class="topbar-right">
				<button id="btn-fullscreen" class="btn-topbar" title="Pantalla Completa">
					⛶ PANTALLA COMPLETA
				</button>
				<a href="/login" class="btn-topbar btn-login">
					INICIAR SESIÓN
				</a>
			</div>
		</header>

		<!-- Contenedor del Juego Godot 4 Web -->
		<main class="game-main-area">
			<div class="game-viewport-card" id="game-viewport">
				<iframe 
					id="godot-iframe"
					src="/game/DUMATH_DEMO_OFICIAL_NMC.html" 
					title="Videojuego DUMATH Demo Oficial"
					allow="autoplay; fullscreen; focus-without-user-activation *"
					tabindex="0"
				></iframe>
			</div>

			<!-- Barra de Controles Rápidos Arcade -->
			<div class="game-footer-bar">
				<div class="control-hints">
					<span class="hint-item"><kbd class="retro-kbd">W A S D</kbd> o <kbd class="retro-kbd">↑ ← ↓ →</kbd> Moverse</span>
					<span class="hint-item"><kbd class="retro-kbd">ESPACIO</kbd> o <kbd class="retro-kbd">ENTER</kbd> Interactuar / Resolver</span>
				</div>
				<div class="game-status-badge">
					<span class="status-dot"></span>
					<span>MODO DEMO PÚBLICO</span>
				</div>
			</div>
			<section class="player-form-card" aria-labelledby="player-form-title">
				<h2 id="player-form-title">DATOS DEL JUGADOR</h2>
				<form id="player-form" class="player-form">
					<div class="form-row">
						<label for="player-name">INGRESA TU NOMBRE</label>
						<input id="player-name" name="name" type="text" required />
					</div>
					<div class="form-row">
						<label for="player-age">INGRESA TU EDAD</label>
						<input id="player-age" name="age" type="number" min="1" max="120" required />
					</div>
					<div class="form-row form-row-check">
						<label for="player-role">¿ERES ESTUDIANTE O DOCENTE?</label>
						<label class="check-option"><input id="player-role" name="legacy-role" type="checkbox" /> ESTUDIANTE</label>
					</div>
					<div class="form-row role-row">
						<span class="field-label">SELECCIONA TU PERFIL</span>
						<div class="check-options">
						<label class="check-option"><input name="role" value="estudiante" type="radio" required /> ESTUDIANTE</label>
						<label class="check-option"><input name="role" value="docente" type="radio" /> DOCENTE</label>
						<label class="check-option"><input name="role" value="colaborador" type="radio" /> COLABORADOR</label>
						</div>
					</div>
					<div class="form-row contact-row">
						<label for="player-contact">NÚMERO DE CONTACTO</label>
						<input id="player-contact" name="contact" type="tel" required />
					</div>
					<div class="form-row opinion-row">
						<label for="player-opinion">MENSAJE / OPINIÓN (MÁXIMO 100 PALABRAS)</label>
						<textarea id="player-opinion" name="opinion" rows="4" maxlength="2000" required></textarea>
					</div>
					<div class="form-actions">
						<button class="btn-topbar btn-submit" type="submit">ENVIAR</button>
						<a class="btn-topbar btn-login" href="/login">INICIAR SESIÓN</a>
					</div>
					<p id="player-form-message" class="player-form-message" role="status"></p>
				</form>
			</section>
		</main>
	</div>
</Layout>

<script>
	const fullscreenBtn = document.getElementById('btn-fullscreen');
	const gameViewport = document.getElementById('game-viewport');

	if (fullscreenBtn && gameViewport) {
		fullscreenBtn.addEventListener('click', () => {
			if (!document.fullscreenElement) {
				gameViewport.requestFullscreen().catch(err => {
					console.error('Error al entrar a pantalla completa:', err);
				});
			} else {
				document.exitFullscreen().catch(err => {
					console.error('Error al salir de pantalla completa:', err);
				});
			}
		});
	}

	const playerForm = document.getElementById('player-form');
	const playerFormMessage = document.getElementById('player-form-message');
	playerForm?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!playerFormMessage || !(playerForm instanceof HTMLFormElement)) return;
		const formData = new FormData(playerForm);
		const roles = formData.getAll('role');
		const payload = {
			nombre: formData.get('name'),
			edad: Number(formData.get('age')),
			rol: roles[0] || '',
			contacto: formData.get('contact'),
			opinion: formData.get('opinion'),
		};
		playerFormMessage.textContent = 'GUARDANDO...';

		try {
			const response = await fetch('/api/visitor-players', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
				body: JSON.stringify(payload),
			});
			const data = await response.json();
			if (!response.ok) throw new Error(data.message || 'No se pudo guardar el registro.');
			playerFormMessage.textContent = 'REGISTRO GUARDADO';
			playerForm.reset();
		} catch (error) {
			playerFormMessage.textContent = error instanceof Error ? error.message : 'Error de conexión.';
		}
	});
</script>

<style define:vars={{ gameBackground: background3.src }}>
	.game-view-wrapper {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		background: #090214;
		background-image: linear-gradient(rgba(9, 2, 20, .76), rgba(9, 2, 20, .88)), var(--game-background);
		background-position: center;
		background-size: cover;
		animation: game-background-drift 28s ease-in-out infinite alternate;
	}

	/* Topbar */
	.game-topbar {
		height: 60px;
		background: #140428;
		border-bottom: 2px solid #581c87;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 24px;
		flex-shrink: 0;
	}

	.game-logo {
		display: flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
	}

	.logo-main {
		font-family: var(--font-retro);
		font-size: 1.2rem;
		color: #ffe600;
		letter-spacing: 2px;
		text-shadow: 0 0 10px rgba(255, 230, 0, 0.5);
	}

	.logo-badge {
		font-family: var(--font-retro);
		font-size: 0.55rem;
		background: #7e22ce;
		color: #ffffff;
		padding: 3px 6px;
		border-radius: 2px;
		letter-spacing: 1px;
	}

	.topbar-right {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.btn-topbar {
		font-family: var(--font-retro);
		font-size: 0.65rem;
		padding: 8px 14px;
		background: #1f073d;
		color: #ffffff;
		border: 1px solid #581c87;
		cursor: pointer;
		text-decoration: none;
		transition: all 0.15s ease;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	.btn-topbar:hover {
		background: #2a0b52;
		border-color: #ffe600;
		color: #ffe600;
	}

	.btn-login {
		background: #270f47;
		border-color: #8b2fc9;
		color: #f3e8ff;
	}

	.btn-login:hover {
		background: #3b1764;
		border-color: #ffe600;
		color: #ffe600;
	}

	.btn-panel {
		background: #ffe600;
		color: #000000;
		border-color: #ffffff;
		font-weight: 700;
	}

	.btn-panel img {
		display: block;
		width: 132px;
		height: 28px;
		object-fit: contain;
	}

	.btn-panel:hover {
		background: #ffea38;
		color: #000000;
	}

	/* Main Game Area */
	.game-main-area {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 16px;
		gap: 12px;
	}

	.game-viewport-card {
		width: 100%;
		max-width: 1200px;
		height: calc(100vh - 130px);
		max-height: 720px;
		background: #000000;
		border: 2px solid #581c87;
		box-shadow: 0 0 30px rgba(88, 28, 135, 0.45);
		position: relative;
		display: flex;
	}

	.game-viewport-card:fullscreen {
		max-width: 100%;
		max-height: 100%;
		height: 100vh;
		border: none;
	}

	#godot-iframe {
		width: 100%;
		height: 100%;
		border: none;
		display: block;
		background: #000000;
	}

	/* Footer Bar */
	.game-footer-bar {
		width: 100%;
		max-width: 1200px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 6px 14px;
		background: #140726;
		border: 1px solid #3b1764;
		font-size: 0.75rem;
		color: #c084fc;
		flex-wrap: wrap;
		gap: 8px;
	}

	.player-form-card {
		width: 100%;
		max-width: 520px;
		margin: 0 auto;
		padding: 18px 22px;
		background: rgba(20, 7, 38, .92);
		border: 2px solid #ffe600;
		box-shadow: 5px 5px 0 #3b1764, 0 0 16px rgba(255, 230, 0, .18);
	}

	.player-form-card h2 {
		margin-bottom: 14px;
		color: #ffe600;
		font-family: var(--font-retro);
		font-size: .75rem;
		text-align: center;
	}

	.player-form { display: grid; gap: 10px; }
	.form-row { display: grid; grid-template-columns: 1fr; align-items: stretch; gap: 6px; }
	.form-row label, .check-option, .btn-submit, .player-form-message { font-family: var(--font-retro); font-size: .58rem; }
	.form-row > label:first-child, .field-label { color: #ffe600; }
	.form-row input[type="text"], .form-row input[type="number"] { width: 100%; padding: 9px 10px; background: #0d031b; border: 1px solid #8b2fc9; color: #fff; font: 1rem var(--font-ui); }
	.form-row textarea { width: 100%; resize: vertical; padding: 9px 10px; background: #0d031b; border: 1px solid #8b2fc9; color: #fff; font: 1rem var(--font-ui); }
	.check-options { display: grid; gap: 8px; }
	.check-option { display: flex; align-items: center; gap: 9px; color: #fff; }
	.check-option input { width: 18px; height: 18px; accent-color: #ffe600; }
	.form-actions { display: flex; justify-content: center; gap: 12px; margin-top: 8px; }
	.btn-submit { box-shadow: none; }
	.player-form-message { min-height: 16px; color: #22c55e; text-align: center; }

	@keyframes game-background-drift {
		0% { background-position: 48% 50%; }
		100% { background-position: 52% 50%; }
	}

	.game-footer-bar, .form-row-check { display: none; }

	.control-hints {
		display: flex;
		align-items: center;
		gap: 18px;
		flex-wrap: wrap;
	}

	.retro-kbd {
		display: inline-block;
		font-family: var(--font-retro);
		font-size: 0.55rem;
		background: #270f47;
		color: #ffe600;
		border: 1px solid #7e22ce;
		padding: 2px 6px;
		border-radius: 2px;
		box-shadow: 1px 1px 0px #090214;
	}

	.game-status-badge {
		display: flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-retro);
		font-size: 0.55rem;
		color: #22c55e;
	}

	.status-dot {
		width: 7px;
		height: 7px;
		background: #22c55e;
		border-radius: 50%;
		box-shadow: 0 0 6px #22c55e;
	}

	@media (max-width: 768px) {
		.game-topbar {
			padding: 0 14px;
		}
		.game-main-area {
			padding: 8px;
		}
		.game-viewport-card {
			height: calc(100vh - 120px);
		}
		.form-row {
			grid-template-columns: 1fr;
			gap: 6px;
		}
		.player-form-card {
			padding: 16px;
		}
	}
</style>
